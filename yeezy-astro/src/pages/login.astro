---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.jsx';
---
<Layout title="LOGIN">
  <Nav client:load activa="" />
  <section class="form-wrap">
    <h1 class="form-titulo">LOG IN</h1>
    <form class="form" id="form-login">
      <input type="email" name="email" placeholder="EMAIL" autocomplete="email" required />
      <input type="password" name="password" placeholder="PASSWORD" autocomplete="current-password" required />
      <button type="submit">LOG IN</button>
      <p class="form-msg" aria-live="polite"></p>
    </form>
    <a class="form-link" href="/registro">CREATE ACCOUNT</a>
  </section>
</Layout>

<script>
  import { login } from '../lib/auth.js';

  const form = document.querySelector<HTMLFormElement>('#form-login');

  if (form) {
    const msg = form.querySelector<HTMLParagraphElement>('.form-msg');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!msg || !button) return;

      const values = new FormData(form);
      const email = String(values.get('email') ?? '').trim();
      const password = String(values.get('password') ?? '');
      button.disabled = true;
      msg.textContent = 'Iniciando sesión...';

      try {
        await login({ email, password });
        msg.textContent = 'Sesión iniciada correctamente.';
      } catch (error) {
        msg.textContent = error instanceof Error
          ? error.message
          : 'No';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>