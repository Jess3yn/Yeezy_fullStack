---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.jsx';
import ProductGrid from '../components/ProductGrid.jsx';
import { getDiscos } from '../lib/api.js';

const discos = await getDiscos();
---
<Layout title="BULLY">
  <Nav client:load activa="bully" />
  <section class="hero">
    <h1>BULLY</h1>
    <p>03.27.2026</p>
  </section>
  <ProductGrid productos={discos} />
</Layout>
