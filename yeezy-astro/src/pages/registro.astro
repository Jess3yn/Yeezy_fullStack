---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.jsx';
---
<Layout title="REGISTRO">
  <Nav client:load activa="" />
  <section class="form-wrap">
    <h1 class="form-titulo">CREATE ACCOUNT</h1>
    <form class="form" id="form-registro">
      <input type="text" name="nombre" placeholder="NAME" required />
      <input type="email" name="email" placeholder="EMAIL" required />
      <input type="password" name="password" placeholder="PASSWORD" required />
      <input type="password" name="confirmar" placeholder="CONFIRM PASSWORD" required />
      <button type="submit">CREATE ACCOUNT</button>
      <p class="form-msg"></p>
    </form>
    <a class="form-link" href="/login">ALREADY HAVE AN ACCOUNT</a>
  </section>
</Layout>

<script>
  import { registro } from '../lib/auth.js';

  const form = document.getElementById('form-registro');
  const msg = form.querySelector('.form-msg');
  const button = form.querySelector('button');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const datos = Object.fromEntries(new FormData(form));
    if (datos.password !== datos.confirmar) {
      msg.textContent = 'Las contraseñas no coinciden';
      return;
    }
    button.disabled = true;
    msg.textContent = 'Creando cuenta…';

    try {
      await registro({
        nombre: datos.nombre,
        email: datos.email,
        password: datos.password,
      });
      msg.textContent = 'Cuenta creada. Ya puedes iniciar sesión.';
    } catch (error) {
      msg.textContent =
        error instanceof Error ? error.message : 'No se pudo crear la cuenta';
    } finally {
      button.disabled = false;
    }
  });
</script>