---
const { title = 'YZY' } = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <footer class="pie">
      <span>CONTACT</span>
      <span>TERMS</span>
      <span>PRIVACY</span>
      <span>ACCESSIBILITY</span>
      <span>COOKIES</span>
      <span>ORDER STATUS</span>
    </footer>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: #fff;
    color: #111;
    font-family: -apple-system, Helvetica, Arial, sans-serif;
  }
  .nav {
    padding: 20px 24px;
    position: sticky;
    top: 0;
    background: #fff;
    z-index: 10;
  }
  .nav-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .iconos { display: flex; gap: 14px; justify-self: end; }
  .menu {
    display: flex;
    gap: 20px;
    grid-column: 2;
    justify-self: center;
  }
  .menu a {
    color: #999;
    font-size: 11px;
    letter-spacing: 1px;
    text-decoration: none;
  }
  .menu a.activo, .menu a:hover { color: #111; }
  .encabezado {
    display: flex;
    justify-content: center;
    padding: 4px 24px 20px;
  }
  .toggle { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }
.toggle a, .toggle button {
  background: none;
  border: none;
  color: #bbb;
  font-size: 12px;
  letter-spacing: 1px;
  text-decoration: none;
  cursor: pointer;
  padding: 0;
  font-family: inherit;
}
.toggle a.activo, .toggle button.activo { color: #111; }
  .grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 30px 14px;
    padding: 0 24px 50px;
  }
  .producto {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .imagen {
  width: 100%;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
  .imagen img { width: 100%; height: 100%; object-fit: contain; transition: opacity .15s ease, transform .25s ease; }
  .producto:hover .imagen img { opacity: .6; transform: scale(1.06); }
  .sin-imagen { width: 60%; height: 60%; background: #f2f2f2; }
  .nombre { font-size: 11px; letter-spacing: 0.5px; color: #111; margin: 0; text-align: center; }
  .seccion {
    font-size: 10px;
    letter-spacing: 2px;
    color: #999;
    text-align: center;
    padding: 34px 24px 16px;
    margin: 0;
  }
  .estado { font-size: 10px; color: #bbb; margin: 0; }
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 30px 24px 10px;
    text-align: center;
    gap: 8px;
  }
  .hero h1 { font-size: 13px; font-weight: 400; letter-spacing: 3px; margin: 0; }
  .lista { padding: 0 24px 50px; max-width: 700px; margin: 0 auto; }
  .fila {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid #eee;
    font-size: 12px;
    letter-spacing: 0.5px;
  }
  .ciudad { width: 110px; font-weight: 600; }
  .recinto { flex: 1; color: #999; }
  .fecha-col { color: #999; width: 100px; }


  .form-wrap {
  max-width: 320px;
  margin: 0 auto;
  padding: 60px 24px 80px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}
.form-titulo { font-size: 13px; letter-spacing: 3px; font-weight: 400; margin: 0; }
.form { width: 100%; display: flex; flex-direction: column; gap: 16px; }
.form input {
  border: none;
  border-bottom: 1px solid #ddd;
  padding: 8px 0;
  font-size: 12px;
  letter-spacing: 0.5px;
  outline: none;
  font-family: inherit;
}
.form input:focus { border-color: #111; }
.form button {
  background: #111;
  color: #fff;
  border: none;
  padding: 12px;
  font-size: 11px;
  letter-spacing: 1px;
  cursor: pointer;
  margin-top: 8px;
  font-family: inherit;
}
.form-msg { font-size: 10px; color: #999; text-align: center; margin: 0; }
.form-link { font-size: 10px; color: #999; letter-spacing: 0.5px; text-decoration: none; }
.form-link:hover { color: #111; }

  .pie {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    padding: 24px;
    color: #bbb;
    font-size: 10px;
    letter-spacing: 0.5px;
  }
  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 480px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>